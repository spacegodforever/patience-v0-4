            "$ref": "#/$defs/BasisItem"
          },
          "title": "Basis",
          "type": "array"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "destructive": {
          "title": "Destructive",
          "type": "boolean"
        },
        "known_action": {
          "title": "Known Action",
          "type": "boolean"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        }
