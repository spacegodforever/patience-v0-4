          "title": "Expires At"
        },
        "gateway_events": {
          "items": {
            "$ref": "#/$defs/GatewayEvent"
          },
          "title": "Gateway Events",
          "type": "array"
        },
        "issued": {
          "title": "Issued",
          "type": "boolean"
        },
        "issued_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issued At"
        },
        "key_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Key Id"
        },
        "permit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Permit Id"
        }
