      "required": [
        "tier",
        "category",
        "known_action",
        "approvals_required",
        "destructive",
        "basis"
      ],
      "title": "PolicyResult",
      "type": "object"
    },
    "Refusal": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "event",
        "actor",
        "reason"
      ],
      "title": "Refusal",
      "type": "object"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "event",
        "actor",
        "hash"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "title": "Item",
          "type": "string"
        },
        "label": {
          "const": "unknown",
          "default": "unknown",
          "title": "Label",
          "type": "string"
        },
        "source": {
          "enum": [
            "advisory",
            "system"
