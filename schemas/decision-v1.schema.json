  "$id": "https://patience.local/schemas/decision-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "title": "Action",
      "type": "string"
    },
    "approvals": {
      "$ref": "#/$defs/ApprovalState"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "created_at": {
      "title": "Created At",
      "type": "number"
    },
    "execution": {
      "$ref": "#/$defs/Execution"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "number"
    },
    "owners": {
      "items": {
        "type": "string"
      },
      "title": "Owners",
      "type": "array"
    },
    "payload_hash": {
      "title": "Payload Hash",
      "type": "string"
    },
    "payload_keys": {
      "items": {
        "type": "string"
      },
      "title": "Payload Keys",
      "type": "array"
    },
    "payload_values": {
      "const": "withheld",
      "title": "Payload Values",
      "type": "string"
    },
    "permit": {
      "$ref": "#/$defs/PermitState"
    },
    "policy": {
      "$ref": "#/$defs/PolicyResult"
    },
    "proposer": {
      "title": "Proposer",
      "type": "string"
    },
    "refusals": {
      "items": {
        "$ref": "#/$defs/Refusal"
      },
      "title": "Refusals",
      "type": "array"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "decision-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "allowed",
        "pending",
        "approved",
        "denied",
        "expired",
        "executing",
        "executed",
        "permit_issued",
        "needs_review",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Timeline",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "$ref": "#/$defs/Unknown"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "what_could_go_wrong": {
      "items": {
        "type": "string"
      },
      "title": "What Could Go Wrong",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "action",
    "proposer",
    "owners",
    "state",
    "payload_hash",
    "payload_keys",
    "payload_values",
    "policy",
    "approvals",
    "refusals",
    "execution",
    "permit",
    "confidence",
    "what_could_go_wrong",
    "unknowns",
    "created_at",
    "expires_at",
    "timeline"
  ],
  "title": "DecisionRecord",
  "type": "object"
}
