{
  "$defs": {
    "ApprovalState": {
      "additionalProperties": false,
      "properties": {
        "granted_by": {
          "items": {
            "type": "string"
          },
          "title": "Granted By",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "integer"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "granted_by",
        "satisfied"
      ],
      "title": "ApprovalState",
      "type": "object"
    },
    "BasisItem": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "enum": [
            "policy_rule",
            "tier_floor",
            "destructive_guard",
            "advisory"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "BasisItem",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low",
            "not_applicable"
          ],
          "title": "Level",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "source": {
          "enum": [
            "rule_derived_advisory",
            "none"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "level",
        "source",
        "note"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dry Run"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "simulated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Simulated"
        },
        "status": {
          "enum": [
            "not_executed",
            "in_progress",
            "executed",
            "failed",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "simulated",
        "dry_run",
        "error"
      ],
      "title": "Execution",
      "type": "object"
    },
    "GatewayEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "title": "Event",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "event",
        "reason_code"
      ],
      "title": "GatewayEvent",
      "type": "object"
    },
    "PermitState": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
